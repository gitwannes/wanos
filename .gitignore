# =========================
# WanOS backend .gitignore
# =========================

# Ignore all dotfiles...
.*

# ...EXCEPT these specific repository config files:
!.gitignore
!.gitattributes

# Keep project Cursor rules in git; ignore other .cursor local state.
# !.cursor/ is required: leading .* would otherwise ignore the parent dir
# and block any re-include of files underneath.
!.cursor/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
# Cloud Agent environment definition (portable, no secrets).
!.cursor/environment.json
!.cursor/install.sh
!.cursor/start.sh
# ...but never the generated runtime state (broker passwd/conf, dev requirements).
.cursor/runtime/

# 1. Secrets & Environment Variables
# (CRITICAL: Never commit the actual .env file containing the MQTT password or PIN)
.env
helpers/lg_webos_client_keys.json

# 2. Dynamic State & Logs
# (These change constantly during runtime and shouldn't be version controlled)
recovery_state.json
status.json
*.log
# Runtime databases and NVRAM (created at repo root when the backend runs)
*.db
wanos-nvram.json
*.zip
/docs/logs
/sessionlog/
/_lcd-agent/docs/logs/
_backup*

# 3. Virtual Environments
# (Ignore your active python environments)
venv/
env/
wanos_venv/
.venv/

# 4. Python Artifacts & Cache
# (Standard Python noise)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Testing & Coverage
# (For when you add tests in later phases)
.coverage
.tox/
.nox/
coverage.xml
*.cover
*.swn
.pytest_cache/
backup*/
_oldwisccode

# 6. OS & IDE Clutter
# (Prevents your editor settings from bleeding into the repo)
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.pid
