# --- file: .gitignore ---
# Compiled from .gitignore.common (sections 1-2) + section 3 below.
# Edit .gitignore.common for shared patterns; keep repo-only noise in section 3.

# === 1. General ===
# Secrets / env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Node
node_modules/

# Logs / caches
*.log
.cache/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/

# Windows / Cursor / sync junk
*.lnk
_tmp*
*.bak


# === 2. Operator common (all Wannes repos) ===

# Local sync site configs (never commit LAN paths/creds)
helpers/*-sync.config
helpers/*-sync.config.json

# Ops log staging (PC pull into git tree)
/docs/logs
docs/logs/

# Runtime DBs (tighten in section 3 if a repo tracks a seed DB)
*.sqlite*
*.db
*.db-wal
*.db-shm

# === 3. WanOS ===

# Ignore all other dotfiles; re-include tracked repo config.
# (.* re-applies after section 1, so repeat needed allowlist here.)
.*
!.gitignore
!.gitignore.common
!.gitattributes
!.env.example
!.cursor/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/environment.json
!.cursor/install.sh
!.cursor/start.sh
.cursor/runtime/

# Device / integration secrets
helpers/lg_webos_client_keys.json

# Runtime state at repo root when backend runs
recovery_state.json
status.json
wanos-nvram.json
*.pid
*.zip

# Extra log / session pulls (beyond common docs/logs)
/sessionlog/
/_lcd-agent/docs/logs/

# Local venv name + backups / legacy trees
wanos_venv/
_backup*
backup*/
_oldwisccode

# Keep docs/todo/_archive/ in git; ignore other _archive dirs
_archive/
!docs/todo/_archive/
!docs/todo/_archive/**

# Editor / test noise not in common
.vscode/
.pytest_cache/
.coverage
*.so
